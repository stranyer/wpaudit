# ---------------------------------------------------------------
# Zona Cero — variables de entorno (copiar a .env.local)
# Todas son opcionales: sin ellas el juego usa datos mock locales.
# ---------------------------------------------------------------

# Supabase (opcional). Si faltan, se usa el repositorio local (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Estilo de mapa MapLibre alternativo (opcional).
# Por defecto se usa un estilo propio sobre los tiles gratuitos de OpenFreeMap.
VITE_MAP_STYLE_URL=

# Radio de interacción en metros (por defecto 40).
VITE_INTERACTION_RADIUS_M=40

# Semilla del mundo: todos los clientes con la misma semilla ven los mismos spawns.
VITE_WORLD_SEED=zona-cero-v1
